PORT=5000
MONGODB_URI=mongodb://localhost:27017/resume_analyzer
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Email Configuration (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=your_sender_email_here

# Brevo SDK Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_sender_email_here
BREVO_SENDER_NAME=your_sender_name_here

# Gemini AI API Configuration (Optional: if empty, falls back to rule-based parser)
GEMINI_API_KEY=your_gemini_api_key_here
